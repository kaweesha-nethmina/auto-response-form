{
  "outputDirectory": "frontend",
  "buildCommand": "",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://RENDER_SERVICE_URL/api/:path*" },
    { "source": "/login", "destination": "https://RENDER_SERVICE_URL/login" },
    { "source": "/logout", "destination": "https://RENDER_SERVICE_URL/logout" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Content-Security-Policy", "value": "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' data:; frame-ancestors 'none'; base-uri 'none'" }
    ] }
  ]
}
